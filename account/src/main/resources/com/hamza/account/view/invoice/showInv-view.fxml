<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" minHeight="520.0" minWidth="720.0" prefHeight="650.0" prefWidth="980.0"
      spacing="12.0" styleClass="app-root,invoice-details"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hamza.account.controller.invoice.ShowInvoiceController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <VBox spacing="12.0" styleClass="app-card,invoice-details-header">
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="invoice-details-title-row">
            <VBox spacing="4.0">
                <Label fx:id="documentTitle" styleClass="page-title" text="%invoice.title" />
                <Label fx:id="paymentBadge" styleClass="invoice-payment-badge" text="%type" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="actionProgress" managed="false" maxHeight="24.0" maxWidth="24.0"
                               minHeight="24.0" minWidth="24.0" prefHeight="24.0" prefWidth="24.0"
                               visible="false" />
            <Button fx:id="btnPrint" mnemonicParsing="false" onAction="#printInvoice"
                    styleClass="app-primary-button" text="%print" />
            <Button fx:id="btnPrintBarcode" mnemonicParsing="false" onAction="#printBarcode"
                    styleClass="app-neutral-button" text="%item.dialog.barcode.title" />
            <Button fx:id="btnClose" mnemonicParsing="false" onAction="#close"
                    styleClass="app-neutral-button" text="%close" />
        </HBox>

        <FlowPane hgap="10.0" prefWrapLength="900.0" vgap="10.0" styleClass="invoice-meta-grid">
            <VBox spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.number" />
                <Label fx:id="valueInvoiceNumber" styleClass="invoice-meta-value" />
            </VBox>
            <VBox spacing="3.0" styleClass="invoice-meta-field,invoice-meta-field-wide">
                <Label fx:id="partyCaption" styleClass="invoice-meta-caption" text="%invoice.pdf.party.customer" />
                <Label fx:id="valueParty" styleClass="invoice-meta-value" />
            </VBox>
            <VBox spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.date" />
                <Label fx:id="valueDate" styleClass="invoice-meta-value" />
            </VBox>
            <VBox spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.stock" />
                <Label fx:id="valueStock" styleClass="invoice-meta-value" />
            </VBox>
            <VBox fx:id="delegateField" spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.delegate" />
                <Label fx:id="valueDelegate" styleClass="invoice-meta-value" />
            </VBox>
            <VBox fx:id="enteredAtField" spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.entry.time" />
                <Label fx:id="valueEnteredAt" styleClass="invoice-meta-value" />
            </VBox>
            <VBox fx:id="sourceInvoiceField" spacing="3.0" styleClass="invoice-meta-field">
                <Label styleClass="invoice-meta-caption" text="%invoice.pdf.source.invoice" />
                <Label fx:id="valueSourceInvoice" styleClass="invoice-meta-value" />
            </VBox>
            <VBox fx:id="returnReasonField" spacing="3.0" styleClass="invoice-meta-field,invoice-meta-field-wide">
                <Label styleClass="invoice-meta-caption" text="%invoice.pdf.return.reason" />
                <Label fx:id="valueReturnReason" styleClass="invoice-meta-value" wrapText="true" />
            </VBox>
            <VBox fx:id="notesField" spacing="3.0" styleClass="invoice-meta-field,invoice-meta-field-wide">
                <Label styleClass="invoice-meta-caption" text="%invoice.notes" />
                <Label fx:id="valueNotes" styleClass="invoice-meta-value" wrapText="true" />
            </VBox>
        </FlowPane>

        <FlowPane hgap="10.0" prefWrapLength="900.0" vgap="10.0" styleClass="invoice-financial-cards">
            <VBox spacing="4.0" styleClass="invoice-kpi-card,invoice-kpi-primary">
                <Label styleClass="invoice-kpi-caption" text="%invoice.total.after.discount" />
                <Label fx:id="valueNet" styleClass="invoice-kpi-value" />
            </VBox>
            <VBox spacing="4.0" styleClass="invoice-kpi-card,invoice-kpi-success">
                <Label styleClass="invoice-kpi-caption" text="%invoice.paid" />
                <Label fx:id="valuePaid" styleClass="invoice-kpi-value" />
            </VBox>
            <VBox fx:id="remainingCard" spacing="4.0" styleClass="invoice-kpi-card">
                <Label styleClass="invoice-kpi-caption" text="%invoice.remaining" />
                <Label fx:id="valueRemaining" styleClass="invoice-kpi-value" />
            </VBox>
        </FlowPane>
    </VBox>

    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="invoice-search-bar">
            <Label fx:id="searchLabel" styleClass="invoice-search-label" text="%search" />
            <TextField fx:id="searchField" promptText="%invoice.details.search.prompt"
                       styleClass="invoice-search-field" HBox.hgrow="ALWAYS" />
            <Label fx:id="searchResult" styleClass="invoice-search-result" />
            <Button fx:id="btnClearSearch" mnemonicParsing="false" onAction="#clearSearch"
                    styleClass="app-neutral-button" text="%common.clear" />
        </HBox>
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tableView" editable="false" styleClass="app-table,invoice-details-table" />
            <VBox fx:id="statePane" alignment="CENTER" maxWidth="420.0" spacing="12.0"
                  styleClass="invoice-state-pane">
                <ProgressIndicator fx:id="stateProgress" maxHeight="44.0" maxWidth="44.0"
                                   prefHeight="44.0" prefWidth="44.0" />
                <Label fx:id="stateMessage" styleClass="invoice-state-message"
                       text="%invoice.details.loading" wrapText="true" />
                <Button fx:id="btnRetry" managed="false" mnemonicParsing="false" onAction="#retryLoad"
                        styleClass="app-neutral-button" text="%invoice.details.retry" visible="false" />
            </VBox>
        </StackPane>
    </VBox>

    <FlowPane hgap="8.0" prefWrapLength="900.0" vgap="8.0"
              styleClass="summary-bar,invoice-details-summary">
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.details.line.count" />
            <Label fx:id="valueLineCount" styleClass="summary-value" />
        </VBox>
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.count.items" />
            <Label fx:id="valueItemCount" styleClass="summary-value" />
        </VBox>
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.count.pieces" />
            <Label fx:id="valueQuantity" styleClass="summary-value" />
        </VBox>
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.total.before.discount" />
            <Label fx:id="valueLinesTotal" styleClass="summary-value" />
        </VBox>
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.total.discount" />
            <Label fx:id="valueLinesDiscount" styleClass="summary-value" />
        </VBox>
        <VBox spacing="2.0" styleClass="invoice-summary-item">
            <Label styleClass="summary-label" text="%invoice.other.discount" />
            <Label fx:id="valueInvoiceDiscount" styleClass="summary-value" />
        </VBox>
        <HBox fx:id="profitSection" spacing="8.0">
            <VBox spacing="2.0" styleClass="invoice-summary-item">
                <Label styleClass="summary-label" text="%invoice.total.cost" />
                <Label fx:id="valueTotalCost" styleClass="summary-value" />
            </VBox>
            <VBox spacing="2.0" styleClass="invoice-summary-item">
                <Label styleClass="summary-label" text="%invoice.gross.profit" />
                <Label fx:id="valueProfit" styleClass="summary-value" />
            </VBox>
        </HBox>
    </FlowPane>
</VBox>
