<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hamza.account.controller.setting.SettingTabLanguageController">
    <children>
        <Label styleClass="settings-subtitle" text="%settings.company.preferencesHint" wrapText="true" />
        <GridPane fx:id="preferencesGrid" hgap="14.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="40.0" minWidth="0.0" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="60.0" minWidth="0.0" hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <VBox fx:id="languageCard" minWidth="0.0" spacing="12.0" styleClass="app-card" GridPane.valignment="TOP">
                    <children>
                        <Label styleClass="section-title" text="%settings.company.languageCurrencyTitle" />
                        <Label styleClass="form-label" text="%settings.language" />
                        <ComboBox fx:id="comboLanguage" maxWidth="Infinity" styleClass="modern-input" />
                        <Label styleClass="form-label" text="%settings.currency" />
                        <ComboBox fx:id="comboCurrency" maxWidth="Infinity" styleClass="modern-input" />
                        <Label fx:id="labelCurrencyPreview" styleClass="settings-subtitle" />
                        <Label fx:id="labelCurrencyNote" minHeight="-Infinity" styleClass="settings-subtitle" wrapText="true" />
                    </children>
                </VBox>
                <VBox fx:id="appearanceCard" minWidth="0.0" spacing="12.0" styleClass="app-card" GridPane.columnIndex="1" GridPane.valignment="TOP">
                    <children>
                        <Label styleClass="section-title" text="%settings.company.appearanceTitle" />
                        <GridPane hgap="12.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100.0" halignment="LEFT" />
                                <ColumnConstraints minWidth="0.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label styleClass="form-label" text="%settings.language.themeLabel" />
                                <HBox alignment="CENTER_LEFT" spacing="16.0" GridPane.columnIndex="1">
                                    <children>
                                        <RadioButton fx:id="radioLight" styleClass="modern-radio" text="%settings.language.themeLight">
                                            <toggleGroup><ToggleGroup fx:id="group" /></toggleGroup>
                                        </RadioButton>
                                        <RadioButton fx:id="radioDark" styleClass="modern-radio" text="%settings.language.themeDark" toggleGroup="$group" />
                                    </children>
                                </HBox>
                                <Label styleClass="form-label" text="%settings.language.uiScaleLabel" GridPane.rowIndex="1" />
                                <ComboBox fx:id="comboUiScale" maxWidth="Infinity" styleClass="modern-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label styleClass="form-label" text="%settings.language.fontLabel" GridPane.rowIndex="2" />
                                <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <children>
                                        <ComboBox fx:id="comboFont" minWidth="0.0" maxWidth="Infinity" styleClass="modern-input" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnAddFont" minWidth="-Infinity" styleClass="neutral-button" text="%settings.language.addFontButton" />
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>
                        <VBox spacing="4.0" styleClass="settings-font-sample">
                            <children>
                                <Label fx:id="labelFontPreview" minHeight="-Infinity" maxWidth="Infinity" styleClass="settings-font-preview" text="%settings.language.fontPreviewSample" wrapText="true" />
                                <Label fx:id="labelFontSupport" styleClass="settings-subtitle" text="%settings.language.fontArabicSupportUnknown" wrapText="true" />
                            </children>
                        </VBox>
                        <Label styleClass="form-label" text="%settings.tables.sectionTitle" />
                        <CheckBox fx:id="checkColumnDividers" styleClass="modern-radio" text="%settings.tables.showColumnDividers" wrapText="true" />
                        <CheckBox fx:id="checkFillColumns" styleClass="modern-radio" text="%settings.tables.fillColumns" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </GridPane>
    </children>
</VBox>
