<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The items screen.

  Four things about the layout are deliberate and are worth not undoing:

  * There is no ScrollPane around the BorderPane. The table is the thing that scrolls,
    and it virtualises its own rows; wrapping the whole screen made the toolbar
    scrollable and gave the table a height it had to be told rather than one it could
    take.
  * The list and the grouped view share a StackPane rather than sitting in a VBox that
    hides one of them. Two nodes each asking for ALWAYS growth in a box, one of them
    unmanaged, is a layout that depends on the order they were added.
  * The toolbar is split into commands on one side and view switches on the other. They
    looked identical before - nine buttons in a row - and half of them change what is
    shown while the other half change the data.
  * Edit and delete are not in the toolbar. They act on one row, so they are buttons in
    that row (the first column): a toolbar button acting on "the selected row" is two
    gestures and needs a "choose a row first" message that exists only because the
    control is in the wrong place. F2 and Delete still act on the selected row.
-->
<StackPane fx:id="stackPane" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.items.ItemsController">
    <children>
        <BorderPane styleClass="app-container">
            <top>
                <VBox spacing="10.0">
                    <children>

                        <!--
                          Title strip: what this screen is, how much of it there is, and which page
                          of it is showing. The page box has a floor (minWidth -Infinity) so the
                          growing region beside it can never squeeze it off the screen.
                        -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="items-header">
                            <children>
                                <Label fx:id="labelTitle" styleClass="app-title" text="%item.title" />
                                <Label fx:id="labelCount" styleClass="items-count-badge" />
                                <Label fx:id="labelFiltered" managed="false" styleClass="items-filtered-badge"
                                       text="%item.status.filtered" visible="false" />
                                <HBox fx:id="pagerBox" alignment="CENTER_LEFT" minWidth="-Infinity" spacing="5.0" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="labelSelected" styleClass="app-subtitle" />
                            </children>
                        </HBox>

                        <!-- Commands on one side, view switches on the other. -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <children>
                                        <Button fx:id="btnNew" mnemonicParsing="false" styleClass="success-button"
                                                text="%item.btn.new" />
                                        <Separator orientation="VERTICAL" />
                                        <MenuButton fx:id="menuButtonPrint" mnemonicParsing="false"
                                                    styleClass="modern-menu-button" text="%item.menu.print">
                                            <items>
                                                <MenuItem fx:id="menuPrint" mnemonicParsing="false"
                                                          text="%item.menu.print.pdf" />
                                                <MenuItem fx:id="menuPrintBarcode" mnemonicParsing="false"
                                                          text="%item.menu.print.barcode" />
                                            </items>
                                        </MenuButton>
                                        <MenuButton fx:id="menuButtonOther" mnemonicParsing="false"
                                                    styleClass="modern-menu-button" text="%item.menu.other">
                                            <items>
                                                <MenuItem fx:id="menuItemConvertGroup" mnemonicParsing="false"
                                                          text="%item.group.manager.title" />
                                                <MenuItem fx:id="menuItemBulkEdit" mnemonicParsing="false"
                                                          text="%item.menu.bulk.edit" />
                                                <MenuItem fx:id="menuItemCard" mnemonicParsing="false"
                                                          text="%item.menu.card" />
                                                <MenuItem fx:id="menuExportExcel" mnemonicParsing="false"
                                                          text="%item.menu.export.excel" />
                                            </items>
                                        </MenuButton>
                                        <Button fx:id="btnReports" mnemonicParsing="false" styleClass="neutral-button"
                                                text="%item.btn.reports" />
                                        <!-- The columns: compact, full, or a hand-picked set - as on the parties lists. -->
                                        <MenuButton fx:id="menuView" mnemonicParsing="false"
                                                    styleClass="modern-menu-button" text="%party.list.view" />
                                    </children>
                                </HBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <HBox alignment="CENTER_RIGHT" spacing="0.0" styleClass="items-segmented">
                                    <children>
                                        <ToggleButton fx:id="btnGroupTree" mnemonicParsing="false"
                                                      styleClass="items-segment" text="%item.btn.group.tree" />
                                        <ToggleButton fx:id="btnGroupedView" mnemonicParsing="false"
                                                      styleClass="items-segment" text="%item.btn.grouped.view" />
                                        <ToggleButton fx:id="btnQuickEdit" mnemonicParsing="false"
                                                      styleClass="items-segment" text="%item.btn.quick.edit" />
                                        <ToggleButton fx:id="btnSelected" mnemonicParsing="false"
                                                      styleClass="items-segment" text="%item.btn.select" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Finding things: scope, text, the quick chips and the filter panel switch. -->
                        <VBox spacing="8.0" styleClass="app-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="comboSearchScope" prefWidth="120.0" />
                                        <ComboBox fx:id="comboMatchMode" prefWidth="130.0" />
                                        <TextField fx:id="txtSearch" promptText="%search" HBox.hgrow="ALWAYS" />
                                        <ToggleButton fx:id="btnFilters" mnemonicParsing="false"
                                                      styleClass="neutral-button" text="%item.filter.button" />
                                        <Button fx:id="btnRefresh" mnemonicParsing="false" styleClass="icon-button" />
                                    </children>
                                </HBox>

                                <!--
                                  The chips are the four or five questions asked every day, one click
                                  each. Anything they set is also settable in the panel below; they are
                                  a shortcut, never a second way of meaning something.
                                -->
                                <FlowPane fx:id="chipBar" hgap="6.0" vgap="6.0" />
                            </children>
                        </VBox>

                        <!--
                          The filter panel. Collapsed by default and unmanaged while collapsed, so it
                          costs no height at all - and the count on the filter button is what stops a
                          condition left on in here from being invisible.
                        -->
                        <VBox fx:id="filterPane" managed="false" spacing="10.0" styleClass="app-card"
                              visible="false">
                            <children>
                                <Label styleClass="section-title" text="%item.filter.title" />
                                <GridPane hgap="10.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="90.0" />
                                        <ColumnConstraints minWidth="150.0" />
                                        <ColumnConstraints minWidth="90.0" />
                                        <ColumnConstraints minWidth="150.0" />
                                        <ColumnConstraints minWidth="90.0" />
                                        <ColumnConstraints minWidth="150.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="form-label" text="%item.filter.group"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <ComboBox fx:id="comboFilterGroup" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label styleClass="form-label" text="%item.filter.active"
                                               GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                        <ComboBox fx:id="comboFilterActive" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                        <Label styleClass="form-label" text="%item.filter.balance"
                                               GridPane.columnIndex="4" GridPane.rowIndex="0" />
                                        <ComboBox fx:id="comboFilterBalance" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="5" GridPane.rowIndex="0" />

                                        <Label styleClass="form-label" text="%item.filter.barcode"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="comboFilterBarcode" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label styleClass="form-label" text="%item.filter.expiry"
                                               GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="comboFilterExpiry" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                        <Label styleClass="form-label" text="%item.filter.usage"
                                               GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="comboFilterUsage" maxWidth="1.7976931348623157E308"
                                                  GridPane.columnIndex="5" GridPane.rowIndex="1" />

                                        <Label styleClass="form-label" text="%item.filter.price.range"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <HBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <TextField fx:id="txtMinPrice" promptText="%item.filter.price.min"
                                                           HBox.hgrow="ALWAYS" />
                                                <TextField fx:id="txtMaxPrice" promptText="%item.filter.price.max"
                                                           HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <!--
                                          The minimum quantity the item is set to - not what it holds. It is
                                          how the items whose minimum was left at 0 or 1 are found, to be
                                          raised together from "bulk edit".
                                        -->
                                        <Label styleClass="form-label" text="%item.filter.minimum.range"
                                               GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                        <HBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                                            <children>
                                                <TextField fx:id="txtMiniFrom" promptText="%item.filter.price.min"
                                                           HBox.hgrow="ALWAYS" />
                                                <TextField fx:id="txtMiniTo" promptText="%item.filter.price.max"
                                                           HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <Label styleClass="form-label" text="%item.filter.saved"
                                               GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="comboSavedFilters" maxWidth="1.7976931348623157E308"
                                                  promptText="%item.filter.saved.none" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="3" />
                                        <HBox spacing="6.0" GridPane.columnIndex="2" GridPane.columnSpan="2"
                                              GridPane.rowIndex="3">
                                            <children>
                                                <Button fx:id="btnSaveFilter" mnemonicParsing="false"
                                                        styleClass="neutral-button" text="%item.filter.save" />
                                                <Button fx:id="btnDeleteFilter" mnemonicParsing="false"
                                                        styleClass="neutral-button" text="%item.filter.delete" />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnApplyFilter" mnemonicParsing="false"
                                                styleClass="primary-button" text="%item.filter.apply" />
                                        <Button fx:id="btnClearFilter" mnemonicParsing="false"
                                                styleClass="neutral-button" text="%item.filter.clear" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                    <BorderPane.margin>
                        <Insets bottom="10.0" />
                    </BorderPane.margin>
                </VBox>
            </top>

            <left>
                <VBox fx:id="groupTreePane" managed="false" minWidth="210.0" prefWidth="240.0" spacing="8.0"
                      styleClass="app-card" visible="false">
                    <children>
                        <Label styleClass="section-title" text="%item.group.tree.title" />
                        <TreeView fx:id="groupTree" VBox.vgrow="ALWAYS" />
                    </children>
                    <BorderPane.margin>
                        <Insets left="10.0" right="10.0" />
                    </BorderPane.margin>
                </VBox>
            </left>

            <center>
                <StackPane>
                    <children>
                        <Pagination fx:id="pagination" styleClass="modern-pagination" />
                        <TreeTableView fx:id="groupedTreeTable" managed="false" styleClass="modern-table-view"
                                       visible="false" />
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</StackPane>
