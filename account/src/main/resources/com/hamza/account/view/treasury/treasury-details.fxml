<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="stackPane" minHeight="620.0" minWidth="980.0" styleClass="app-root,treasury-statement" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.convert_treasury.TreasureDetailsController">
    <BorderPane styleClass="app-container">
        <top>
            <VBox spacing="5.0" styleClass="page-container">
                <VBox spacing="3.0">
                    <Label styleClass="page-title" text="%treasury.statement.title" />
                    <Label styleClass="page-subtitle" text="%treasury.statement.subtitle" wrapText="true" />
                </VBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <VBox alignment="CENTER" spacing="4.0" styleClass="treasury-statement-summary-card">
                        <Label styleClass="treasury-statement-summary-label" text="%treasury.statement.summary.opening" />
                        <Label fx:id="openingBalance" styleClass="treasury-statement-summary-value" text="0.00" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0" styleClass="treasury-statement-summary-card,statement-income">
                        <Label styleClass="treasury-statement-summary-label" text="%treasury.statement.summary.income" />
                        <Label fx:id="sumIncome" styleClass="treasury-statement-summary-value" text="0.00" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0" styleClass="treasury-statement-summary-card,statement-output">
                        <Label styleClass="treasury-statement-summary-label" text="%treasury.statement.summary.output" />
                        <Label fx:id="sumOutput" styleClass="treasury-statement-summary-value" text="0.00" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0" styleClass="treasury-statement-summary-card">
                        <Label styleClass="treasury-statement-summary-label" text="%treasury.statement.summary.net" />
                        <Label fx:id="netMovement" styleClass="treasury-statement-summary-value" text="0.00" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0" styleClass="treasury-statement-summary-card,statement-closing">
                        <Label styleClass="treasury-statement-summary-label" text="%treasury.statement.summary.closing" />
                        <Label fx:id="closingBalance" styleClass="treasury-statement-summary-value" text="0.00" />
                    </VBox>
                </HBox>
                <!-- Ordered by ListToolbar in TreasureDetailsController. The treasury and the period stay
                     in the bar - they say which statement this is; the rest is behind the filters button. -->
                <VBox spacing="8.0" styleClass="app-card">
                    <FlowPane fx:id="toolbarRow" alignment="CENTER_LEFT" hgap="8.0" vgap="8.0">
                        <HBox fx:id="periodBox" alignment="CENTER_LEFT" spacing="6.0">
                            <Label styleClass="form-label" text="%treasury.label.treasury" />
                            <ComboBox fx:id="comboTreasury" prefWidth="190.0" styleClass="modern-input" />
                            <Label styleClass="form-label" text="%treasury.label.from.date" />
                            <DatePicker fx:id="dateFrom" prefWidth="140.0" styleClass="modern-input" />
                            <Label styleClass="form-label" text="%treasury.label.to.date" />
                            <DatePicker fx:id="dateTo" prefWidth="140.0" styleClass="modern-input" />
                        </HBox>
                        <Button fx:id="btnSearch" onAction="#search" styleClass="app-primary-button" text="%search" />
                        <ToggleButton fx:id="btnFilters" mnemonicParsing="false" />
                        <Button fx:id="btnReset" onAction="#resetFilters" styleClass="app-neutral-button" text="%invoice.search.clear" />
                        <Button fx:id="btnRefresh" onAction="#refresh" styleClass="app-neutral-button" text="%refresh" />
                        <Button fx:id="btnPrint" onAction="#printStatement" styleClass="app-neutral-button" text="%print" />
                    </FlowPane>
                    <HBox fx:id="filterPane" alignment="CENTER_LEFT" spacing="8.0">
                        <Label styleClass="form-label" text="%treasury.label.account.type" />
                        <ComboBox fx:id="comboDetails" prefWidth="190.0" styleClass="modern-input" />
                        <Label styleClass="form-label" text="%treasury.label.user" />
                        <ComboBox fx:id="comboUsers" prefWidth="190.0" styleClass="modern-input" />
                    </HBox>
                    <Label fx:id="statusLabel" styleClass="page-subtitle" text="%treasury.statement.status.loading" />
                </VBox>
            </VBox>
        </top>
        <center>
            <VBox spacing="5.0" styleClass="page-container" BorderPane.alignment="CENTER">
                <TableView fx:id="tableView" styleClass="app-table,table-section" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="btnPrevious" onAction="#previousPage" styleClass="app-neutral-button" text="%treasury.statement.previous" />
                    <Label fx:id="pageLabel" styleClass="form-label" text="" />
                    <Button fx:id="btnNext" onAction="#nextPage" styleClass="app-neutral-button" text="%treasury.statement.next" />
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
