<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.hamza.account.controller.convert_treasury.TreasuryCapitalController">

    <top>
        <VBox spacing="18" styleClass="page-container">
            <padding>
                <Insets bottom="18" left="28" right="28" top="24" />
            </padding>

            <VBox spacing="6">
                <Label styleClass="page-title" text="%treasury.capital.title" />
                <Label styleClass="page-subtitle" text="%treasury.capital.subtitle" />
            </VBox>

            <VBox spacing="8.0" styleClass="app-card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="form-label" text="%treasury.label.from.date" />
                    <DatePicker fx:id="fromDate" styleClass="modern-input" />
                    <Label styleClass="form-label" text="%treasury.label.to.date" />
                    <DatePicker fx:id="toDate" styleClass="modern-input" />
                    <Button onAction="#reload" styleClass="primary-button" text="%common.refresh" />
                    <HBox fx:id="reportActions" alignment="CENTER_LEFT" spacing="8" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="paidInLabel" styleClass="section-title" />
                    <Label fx:id="drawnLabel" styleClass="section-title" />
                    <Label fx:id="netLabel" styleClass="section-title" />
                </HBox>

                <Label styleClass="page-subtitle" text="%treasury.capital.hint" wrapText="true" />
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="5.0" styleClass="table-section">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>

            <TableView fx:id="movementsTable" styleClass="app-table" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>

</BorderPane>
