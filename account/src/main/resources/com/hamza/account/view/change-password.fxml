<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" alignment="TOP_CENTER" minHeight="630.0" minWidth="570.0"
           prefHeight="670.0" prefWidth="610.0"
           styleClass="app-root,password-change-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.users.ChangePassController">
    <children>
        <VBox maxHeight="-Infinity" maxWidth="560.0" spacing="11.0" styleClass="password-change-card">
            <padding><Insets top="18.0" right="24.0" bottom="18.0" left="24.0"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <StackPane fx:id="headerIcon" minHeight="58.0" minWidth="58.0"
                                   prefHeight="58.0" prefWidth="58.0" styleClass="password-change-icon"/>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="titleLabel" text="%password.change.title" styleClass="page-title"/>
                                <Label fx:id="subtitleLabel" text="%password.change.subtitle"
                                       styleClass="page-subtitle" wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label fx:id="requiredBanner" text="%password.change.required.banner"
                       managed="false" visible="false" wrapText="true" styleClass="password-required-banner"/>
                <Label fx:id="accountLabel" text="%password.change.account" styleClass="password-account-chip"/>
                <Separator/>

                <VBox spacing="7.0">
                    <children>
                        <Label text="%password.change.current" styleClass="form-label"/>
                        <StackPane styleClass="password-field-shell">
                            <children>
                                <PasswordField fx:id="currentPassword" maxWidth="1.7976931348623157E308"
                                               promptText="%password.change.current.prompt"
                                               styleClass="modern-input,password-change-field"/>
                                <TextField fx:id="currentPasswordVisible" managed="false"
                                           maxWidth="1.7976931348623157E308"
                                           promptText="%password.change.current.prompt"
                                           styleClass="modern-input,password-change-field" visible="false"/>
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <VBox spacing="7.0">
                    <children>
                        <Label text="%password.change.new" styleClass="form-label"/>
                        <StackPane styleClass="password-field-shell">
                            <children>
                                <PasswordField fx:id="newPassword" maxWidth="1.7976931348623157E308"
                                               promptText="%password.change.new.prompt"
                                               styleClass="modern-input,password-change-field"/>
                                <TextField fx:id="newPasswordVisible" managed="false"
                                           maxWidth="1.7976931348623157E308"
                                           promptText="%password.change.new.prompt"
                                           styleClass="modern-input,password-change-field" visible="false"/>
                            </children>
                        </StackPane>
                        <ProgressBar fx:id="strengthProgress" minHeight="7.0" prefHeight="7.0"
                                     maxHeight="7.0" maxWidth="1.7976931348623157E308"
                                     progress="0.0" styleClass="password-strength-bar,strength-empty"/>
                        <Label fx:id="strengthLabel" text="%password.change.strength.empty"
                               styleClass="password-strength-label"/>
                    </children>
                </VBox>

                <VBox spacing="7.0">
                    <children>
                        <Label text="%password.change.confirmation" styleClass="form-label"/>
                        <StackPane styleClass="password-field-shell">
                            <children>
                                <PasswordField fx:id="confirmationPassword" maxWidth="1.7976931348623157E308"
                                               promptText="%password.change.confirmation.prompt"
                                               styleClass="modern-input,password-change-field"/>
                                <TextField fx:id="confirmationPasswordVisible" managed="false"
                                           maxWidth="1.7976931348623157E308"
                                           promptText="%password.change.confirmation.prompt"
                                           styleClass="modern-input,password-change-field" visible="false"/>
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <VBox spacing="7.0" styleClass="password-rules-card">
                    <children>
                        <Label text="%password.change.rules.title" styleClass="password-rules-title"/>
                        <Label fx:id="minimumStateLabel" text="%password.change.minimum.pending"
                               styleClass="password-rule,password-rule-pending"/>
                        <Label fx:id="confirmationStateLabel" text="%password.change.match.pending"
                               styleClass="password-rule,password-rule-pending"/>
                    </children>
                </VBox>

                <CheckBox fx:id="showPasswords" text="%password.change.show.passwords"
                          styleClass="password-show-toggle"/>
                <Label text="%password.change.security.hint" wrapText="true" styleClass="password-security-hint"/>
                <Label fx:id="statusLabel" managed="false" text="" visible="false" wrapText="true"
                       styleClass="password-change-status"/>

                <HBox fx:id="actionsBar" alignment="CENTER_RIGHT" spacing="10.0"
                      styleClass="password-change-actions">
                    <children>
                        <ProgressIndicator fx:id="busyIndicator" managed="false" maxHeight="24.0"
                                           maxWidth="24.0" visible="false"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="cancelButton" cancelButton="true" text="%cancel"
                                styleClass="neutral-button"/>
                        <Button fx:id="saveButton" defaultButton="true" text="%password.change.action.save"
                                styleClass="primary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
</StackPane>
