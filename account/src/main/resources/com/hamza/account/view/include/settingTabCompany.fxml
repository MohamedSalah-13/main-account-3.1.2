<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hamza.account.controller.setting.SettingCompanyController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll-pane"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="14.0" styleClass="app-container">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="companyTitle" styleClass="settings-title" text="%settings.company.tabTitle" />
                                <Label fx:id="companySubtitle" styleClass="settings-subtitle" text="%settings.company.overviewSubtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <!-- One card groups the company fields, logo and their save actions. -->
                        <VBox spacing="14.0" styleClass="app-card">
                            <children>
                                <HBox spacing="18.0">
                                    <children>
                                        <VBox minWidth="0.0" spacing="12.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="basicInfoTitle" styleClass="section-title" text="%settings.company.basicInfo" />
                                                <GridPane hgap="12.0" vgap="12.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="50.0" minWidth="0.0" hgrow="ALWAYS" />
                                                        <ColumnConstraints percentWidth="50.0" minWidth="0.0" hgrow="ALWAYS" />
                                                    </columnConstraints>
                                                    <children>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <Label fx:id="labelName" styleClass="form-label" text="%name" />
                                                                <TextField fx:id="textNameCompany" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5.0" GridPane.columnIndex="1">
                                                            <children>
                                                                <Label fx:id="labelAddress" styleClass="form-label" text="%address" />
                                                                <TextField fx:id="textAddress" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5.0" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label fx:id="labelTel" styleClass="form-label" text="%tel" />
                                                                <TextField fx:id="textTel" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                                            <children>
                                                                <Label fx:id="labelTax" styleClass="form-label" text="%tax" />
                                                                <TextField fx:id="textTax" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                                            <children>
                                                                <Label fx:id="labelCom" styleClass="form-label" text="%commercial" />
                                                                <TextField fx:id="textCom" styleClass="modern-input" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>
                                        <VBox minWidth="210.0" prefWidth="230.0" maxWidth="230.0" spacing="8.0" styleClass="company-logo-panel">
                                            <children>
                                                <Label fx:id="logoTitle" styleClass="section-title" text="%settings.company.logoTitle" />
                                                <VBox fx:id="logoDropZone" alignment="CENTER" minHeight="155.0" spacing="8.0" styleClass="logo-drop">
                                                    <children>
                                                        <ImageView fx:id="imageView" fitHeight="130.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                                                    </children>
                                                </VBox>
                                                <Label fx:id="labelLogoInfo" minHeight="-Infinity" styleClass="kpi-hint" text="" wrapText="true" />
                                                <HBox alignment="CENTER" spacing="8.0">
                                                    <children>
                                                        <Button fx:id="btnAddImage" maxWidth="Infinity" mnemonicParsing="false" styleClass="success-button" text="%choose_file" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnClearImage" maxWidth="Infinity" mnemonicParsing="false" styleClass="danger-button" text="%delete" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="company-actions">
                                    <children>
                                        <ProgressIndicator fx:id="progress" maxHeight="18.0" maxWidth="18.0" visible="false" />
                                        <Label fx:id="labelStatus" minWidth="0.0" styleClass="kpi-hint" text="" wrapText="true" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnReset" disable="true" mnemonicParsing="false" styleClass="neutral-button" text="%cancel" />
                                        <Button fx:id="btnSave" disable="true" mnemonicParsing="false" styleClass="primary-button" text="%common.save" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox fx:id="systemSettings" spacing="14.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
