<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The options themselves are not written here: DeleteDataController builds one
    card per section and one check box per WipeTarget out of the catalog, so a
    target added there appears on the screen without an fx:id, a field and a row
    index having to be added to match. What is left is the frame.
-->
<StackPane fx:id="stackPane" prefHeight="640.0" prefWidth="860.0" styleClass="app-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.others.DeleteDataController">
    <children>
        <BorderPane styleClass="app-container">

            <top>
                <VBox spacing="10.0">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="app-title" text="حذف البيانات" />
                                <Label styleClass="app-subtitle"
                                       text="اختر ما تريد مسحه؛ ما يعتمد عليه سيُختار معه تلقائياً" />
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card, danger-card">
                            <children>
                                <Label styleClass="app-section-title" text="⚠" />
                                <Label maxWidth="1.7976931348623157E308" styleClass="info-text" wrapText="true"
                                       text="لا يمكن التراجع عن هذه العملية. تُؤخذ نسخة احتياطية قبل البدء، وإذا فشلت النسخة لا يتم الحذف."
                                       HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <BorderPane.margin>
                        <Insets bottom="12.0" />
                    </BorderPane.margin>
                </VBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" styleClass="app-scroll-pane" BorderPane.alignment="CENTER">
                    <content>
                        <!-- Wraps to however wide the window is, rather than to two fixed columns. -->
                        <FlowPane fx:id="targetsPane" hgap="12.0" prefWrapLength="820.0" vgap="12.0" />
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="summary-bar">
                            <children>
                                <!-- One line with an ellipsis, not wrapped: everything
                                     ticked is fifteen names, and wrapping them took the
                                     height out of the cards. The tooltip has the lot. -->
                                <Label fx:id="summaryLabel" maxWidth="1.7976931348623157E308"
                                       HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ToggleButton fx:id="btnSelected" mnemonicParsing="false"
                                              styleClass="app-neutral-button, select-action-toggle" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSave" mnemonicParsing="false" styleClass="app-danger-button" />
                                <Button fx:id="btnClose" mnemonicParsing="false" styleClass="app-neutral-button" />
                            </children>
                        </HBox>
                    </children>
                    <BorderPane.margin>
                        <Insets top="12.0" />
                    </BorderPane.margin>
                </VBox>
            </bottom>

        </BorderPane>
    </children>
</StackPane>
