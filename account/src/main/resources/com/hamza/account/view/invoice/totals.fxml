<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!--
  One screen serves sales, sales returns, purchases and purchase returns. The
  controller gives the root a document identity class; this layout keeps the
  structure common while CSS supplies the relevant accent.

  The table owns scrolling. Search stays visible, while the less frequently used
  conditions live in a managed/visible filter panel like the items catalogue.
-->
<StackPane fx:id="stackPane" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.invoice.TotalsController">
    <children>
        <BorderPane styleClass="app-container">
            <top>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="totals-header">
                            <children>
                                <Label fx:id="labelScreenTitle" styleClass="app-title,totals-screen-title" />
                                <Label fx:id="labelResults" styleClass="totals-count-badge" />
                                <Label fx:id="labelFiltered" managed="false" styleClass="totals-filtered-badge"
                                       visible="false" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="labelDateRange" styleClass="app-subtitle,totals-date-range" />
                            </children>
                        </HBox>

                        <VBox spacing="10.0" styleClass="app-card,totals-search-card">
                            <children>
                                <!--
                                  One row, not two. Opening, editing and deleting a document
                                  moved onto the row that document is on, which left a whole
                                  card holding three buttons that act on the list as a whole -
                                  and cost the table the height of a card to say so.
                                -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="totals-search-bar">
                                    <children>
                                        <Label fx:id="searchIcon" styleClass="totals-search-icon" />
                                        <TextField fx:id="textSearch" promptText="%invoice.search.free.text.prompt"
                                                   HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnSearch" mnemonicParsing="false" styleClass="primary-button"
                                                text="%search" />
                                        <ToggleButton fx:id="btnFilters" mnemonicParsing="false"
                                                      styleClass="neutral-button" text="%invoice.search.filters" />
                                        <Button fx:id="btnClearFilters" mnemonicParsing="false"
                                                styleClass="neutral-button" text="%invoice.search.clear" />
                                        <Separator orientation="VERTICAL" />
                                        <Button fx:id="btnRefresh" mnemonicParsing="false" styleClass="icon-button" />
                                        <ToggleButton fx:id="btnSelected" mnemonicParsing="false"
                                                      styleClass="neutral-button" text="%common.select.all" />
                                        <Button fx:id="btnDeleteSelected" mnemonicParsing="false"
                                                styleClass="danger-button" text="%delete" />
                                        <MenuButton fx:id="menuButton" mnemonicParsing="false"
                                                    styleClass="modern-menu-button" text="%print">
                                            <items>
                                                <MenuItem fx:id="menuItemPrintTotals" mnemonicParsing="false"
                                                          text="%invoice.btn.print.totals" />
                                                <MenuItem fx:id="menuItemPrintDetailed" mnemonicParsing="false"
                                                          text="%invoice.btn.print.detailed" />
                                                <SeparatorMenuItem />
                                                <MenuItem fx:id="menuItemReportByParty" mnemonicParsing="false"
                                                          text="%invoice.report.by.party" />
                                                <MenuItem fx:id="menuItemReportByDay" mnemonicParsing="false"
                                                          text="%invoice.report.by.day" />
                                                <MenuItem fx:id="menuItemReportByMonth" mnemonicParsing="false"
                                                          text="%invoice.report.by.month" />
                                                <MenuItem fx:id="menuItemReportByDelegate" mnemonicParsing="false"
                                                          text="%invoice.report.by.delegate" />
                                                <MenuItem fx:id="menuItemReportByItem" mnemonicParsing="false"
                                                          text="%invoice.report.by.item" />
                                            </items>
                                        </MenuButton>
                                    </children>
                                </HBox>

                                <VBox fx:id="filterPane" managed="false" spacing="10.0" visible="false">
                                    <children>
                                        <Separator />
                                        <Label styleClass="section-title" text="%invoice.search.section.filters" />
                                        <GridPane hgap="10.0" vgap="8.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="90.0" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                                                <ColumnConstraints minWidth="90.0" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                            </rowConstraints>
                                            <children>
                                                <Label styleClass="form-label" text="%from"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <DatePicker fx:id="dateFrom" editable="false" maxWidth="1.7976931348623157E308"
                                                            GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                <Label styleClass="form-label" text="%to"
                                                       GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                                <DatePicker fx:id="dateTo" editable="false" maxWidth="1.7976931348623157E308"
                                                            GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                                <Label styleClass="form-label" text="%name"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="comboName" maxWidth="1.7976931348623157E308"
                                                          promptText="%name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label fx:id="labelDelegate" styleClass="form-label" text="%NAME_DELEGATE"
                                                       GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="comboDelegate" maxWidth="1.7976931348623157E308"
                                                          promptText="%NAME_DELEGATE" GridPane.columnIndex="3"
                                                          GridPane.rowIndex="1" />

                                                <Label styleClass="form-label" text="%invoice.search.entered.by"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <ComboBox fx:id="comboEnteredBy" maxWidth="1.7976931348623157E308"
                                                          promptText="%invoice.search.entered.by" GridPane.columnIndex="1"
                                                          GridPane.rowIndex="2" />
                                                <Label styleClass="form-label" text="%invoice.number"
                                                       GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                                <TextField fx:id="textInvoiceNumber" maxWidth="1.7976931348623157E308"
                                                           promptText="%invoice.number" GridPane.columnIndex="3"
                                                           GridPane.rowIndex="2" />

                                                <Label styleClass="form-label" text="%invoice.search.min.total"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                <TextField fx:id="textMinTotal" maxWidth="1.7976931348623157E308"
                                                           promptText="%invoice.search.min.total" GridPane.columnIndex="1"
                                                           GridPane.rowIndex="3" />
                                                <Label styleClass="form-label" text="%invoice.search.max.total"
                                                       GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                                <TextField fx:id="textMaxTotal" maxWidth="1.7976931348623157E308"
                                                           promptText="%invoice.search.max.total" GridPane.columnIndex="3"
                                                           GridPane.rowIndex="3" />
                                            </children>
                                        </GridPane>

                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="form-label" text="%invoice.search.payment.type" />
                                                <HBox alignment="CENTER_LEFT" spacing="0.0"
                                                      styleClass="totals-payment-segmented">
                                                    <children>
                                                        <ToggleButton fx:id="radioAll" mnemonicParsing="false" selected="true"
                                                                      styleClass="totals-payment-segment" text="%all">
                                                            <toggleGroup>
                                                                <ToggleGroup fx:id="paymentGroup" />
                                                            </toggleGroup>
                                                        </ToggleButton>
                                                        <ToggleButton fx:id="radioCash" mnemonicParsing="false"
                                                                      styleClass="totals-payment-segment"
                                                                      text="%invoice.totals.radio.cash"
                                                                      toggleGroup="$paymentGroup" />
                                                        <ToggleButton fx:id="radioDeffer" mnemonicParsing="false"
                                                                      styleClass="totals-payment-segment" text="%defer"
                                                                      toggleGroup="$paymentGroup" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                                              styleClass="totals-saved-filters-row">
                                            <children>
                                                <Label styleClass="form-label"
                                                       text="%invoice.search.saved.label" />
                                                <ComboBox fx:id="comboSavedFilters"
                                                          maxWidth="1.7976931348623157E308"
                                                          promptText="%invoice.search.saved.none"
                                                          HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnSaveFilter" mnemonicParsing="false"
                                                        styleClass="neutral-button"
                                                        text="%invoice.search.saved.save" />
                                                <Button fx:id="btnDeleteSavedFilter" mnemonicParsing="false"
                                                        styleClass="danger-button"
                                                        text="%invoice.search.saved.delete" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                    <BorderPane.margin>
                        <Insets bottom="10.0" />
                    </BorderPane.margin>
                </VBox>
            </top>

            <center>
                <VBox spacing="6.0">
                    <children>
                        <TableView fx:id="tableView" styleClass="app-table,totals-table"
                                   VBox.vgrow="ALWAYS" />
                        <!-- Hidden while one page holds the whole result. -->
                        <HBox fx:id="pagerBar" alignment="CENTER" managed="false" spacing="8.0"
                              styleClass="totals-pager" visible="false">
                            <children>
                                <Button fx:id="btnPreviousPage" mnemonicParsing="false"
                                        styleClass="neutral-button" text="%invoice.search.previous" />
                                <Label fx:id="labelPage" styleClass="totals-page-label" />
                                <Button fx:id="btnNextPage" mnemonicParsing="false"
                                        styleClass="neutral-button" text="%invoice.search.next" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </center>

            <bottom>
                <FlowPane alignment="CENTER" hgap="8.0" prefWrapLength="900.0" vgap="8.0"
                          styleClass="summary-bar,totals-summary-bar">
                    <children>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%count" />
                                <Text fx:id="textSumTableSize" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%total" />
                                <Text fx:id="textSumTotals" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%discount" />
                                <Text fx:id="textSumDiscount" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%invoice.total.after.discount" />
                                <Text fx:id="textSumAfterDiscount" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%paid" />
                                <Text fx:id="textCash" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%invoice.summary.remaining" />
                                <Text fx:id="textDeffer" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="totals-summary-item">
                            <children>
                                <Label text="%common.profit" />
                                <Text fx:id="textProfit" styleClass="text-sum" text="0" />
                            </children>
                        </VBox>
                    </children>
                    <BorderPane.margin>
                        <Insets top="10.0" />
                    </BorderPane.margin>
                </FlowPane>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
