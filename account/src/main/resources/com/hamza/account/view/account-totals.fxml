<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The shell of the balances screen. Everything in it is built by AccountController2 in code, so
  this file has two nodes and no captions.

  It used to declare the whole screen - fourteen controls with English text the controller replaced
  at runtime, a TableView the controller then cleared and rebuilt, and a toolbar whose buttons the
  controller wired by field. That is two files that have to agree about one screen, and they did not:
  a dead row-colouring method addressed columns by index, and the export button asked one thing and
  exported another. A screen assembled in one place cannot disagree with itself.
-->
<StackPane fx:id="stackPane" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.name_account.AccountController2">
    <children>
        <VBox fx:id="box" spacing="8.0" styleClass="app-container">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
        </VBox>
    </children>
</StackPane>
