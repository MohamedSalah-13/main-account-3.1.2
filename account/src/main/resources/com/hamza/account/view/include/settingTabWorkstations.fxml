<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.setting.WorkstationsController">
    <children>
        <ScrollPane fitToWidth="true" styleClass="settings-scroll-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="14.0" styleClass="app-container,settings-workstations-page">
                    <children>
                        <VBox spacing="3.0" styleClass="settings-workstations-heading">
                            <children>
                                <Label text="%workstations.title" styleClass="settings-title" />
                                <Label text="%workstations.subtitle" styleClass="settings-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card,workstation-owner-card">
                            <children>
                                <Label text="%workstations.status.backup.owner" styleClass="section-title" />
                                <Label fx:id="lblOwner" styleClass="info-text" maxWidth="1.7976931348623157E308" wrapText="true" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <VBox spacing="8.0" styleClass="app-card,workstation-table-card" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="table" styleClass="modern-table" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card,settings-workstations-actions">
                            <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0" /></padding>
                            <children>
                                <Button fx:id="btnRefresh" text="%common.refresh" onAction="#refresh" styleClass="neutral-button" />
                                <Button fx:id="btnMakeOwner" text="%workstations.make.owner" onAction="#makeOwner" styleClass="primary-button" />
                                <Button fx:id="btnForget" text="%workstations.forget" onAction="#forget" styleClass="danger-button" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
