<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The shell of the employees screen. Everything in it is built by EmployeesScreenController in
  code, so this file has two nodes and no captions.

  What it replaces said the opposite: addEmployee.fxml carried nine labels reading "Code", "Name",
  "Salary" in English, which the controller overwrote one by one at startup - two files that have to
  agree about one screen, and a caption the controller forgets ships in the wrong language. It also
  declared a VBox for the employee's picture that nothing ever filled.
-->
<StackPane fx:id="stackPane" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.employee.EmployeesScreenController">
    <children>
        <VBox fx:id="box" spacing="8.0" styleClass="app-container">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
        </VBox>
    </children>
</StackPane>
