<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hamza.account.controller.items.ItemImageController">
    <top>
        <VBox spacing="4.0" styleClass="app-card">
            <children>
                <Label styleClass="app-title" text="%item.image" />
                <Label fx:id="labelItemName" styleClass="app-subtitle" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="imagePane" styleClass="image-preview-card">
            <children>
                <ImageView fx:id="imageView" managed="false" preserveRatio="true" smooth="true"
                           visible="false" />
                <VBox fx:id="stateBox" alignment="CENTER" spacing="12.0">
                    <children>
                        <ProgressIndicator fx:id="progress" maxHeight="42.0" maxWidth="42.0" />
                        <Label fx:id="labelStatus" styleClass="status-label" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false"
                        styleClass="neutral-button" text="%close" />
            </children>
            <BorderPane.margin>
                <Insets top="12.0" />
            </BorderPane.margin>
        </HBox>
    </bottom>
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>
</BorderPane>
