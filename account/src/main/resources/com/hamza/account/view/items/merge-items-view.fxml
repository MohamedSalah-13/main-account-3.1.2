<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.items.MergeItemsController">
    <children>
        <BorderPane styleClass="app-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <VBox spacing="8.0" BorderPane.alignment="CENTER">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card">
                            <children>
                                <Label styleClass="form-label" text="%item.merge.label.group.by" />
                                <ComboBox fx:id="comboGroupBy" minWidth="220.0" />
                                <Button fx:id="btnRefresh" mnemonicParsing="false" styleClass="neutral-button" text="%item.merge.btn.refresh" />
                                <ProgressIndicator fx:id="progress" maxHeight="18.0" maxWidth="18.0" visible="false" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnSetTarget" mnemonicParsing="false" styleClass="neutral-button" text="%item.merge.btn.set.target" />
                                <Button fx:id="btnPreview" mnemonicParsing="false" styleClass="neutral-button" text="%item.merge.btn.preview" />
                                <Button fx:id="btnMerge" mnemonicParsing="false" styleClass="primary-button" text="%item.merge.btn.merge" />
                            </children>
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                        </HBox>

                        <!-- The target, and what the merge would move. Both are text rather than
                             tiles: the sentence is what a user checks before pressing a button
                             that deletes an item. -->
                        <VBox spacing="4.0" styleClass="app-card">
                            <children>
                                <Label fx:id="labelTarget" styleClass="form-label" text="%item.merge.label.target.none" wrapText="true" />
                                <Label fx:id="labelPreview" styleClass="kpi-hint" text="%item.merge.hint" wrapText="true" />
                            </children>
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="6.0" />
                    </padding>
                </VBox>
            </top>
            <center>
                <VBox spacing="6.0" BorderPane.alignment="CENTER">
                    <children>
                        <TableView fx:id="tableCandidates" styleClass="modern-table" VBox.vgrow="ALWAYS" />

                        <Label styleClass="form-label" text="%item.merge.operations.title" />
                        <TableView fx:id="tableOperations" prefHeight="220.0" styleClass="modern-table" />
                    </children>
                    <padding>
                        <Insets bottom="6.0" left="6.0" right="6.0" />
                    </padding>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
