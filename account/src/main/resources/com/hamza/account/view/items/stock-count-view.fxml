<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.items.StockCountController">
    <children>
        <BorderPane styleClass="app-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <VBox spacing="8.0" BorderPane.alignment="CENTER">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card">
                            <children>
                                <Label styleClass="form-label" text="%item.stockcount.label.count.date" />
                                <DatePicker fx:id="datePicker" minWidth="140.0" />

                                <Label styleClass="form-label" text="%invoice.notes" />
                                <TextField fx:id="textNotes" minWidth="200.0" promptText="%item.stockcount.prompt.optional" />

                                <Label fx:id="labelStatus" styleClass="summary-light-label" text="%item.stockcount.status.draft" />
                                <ProgressIndicator fx:id="progress" maxHeight="18.0" maxWidth="18.0" visible="false" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnDelete" mnemonicParsing="false" styleClass="danger-button" text="%item.stockcount.btn.delete.draft" />
                                <Button fx:id="btnSave" mnemonicParsing="false" styleClass="neutral-button" text="%common.save" />
                                <Button fx:id="btnPost" mnemonicParsing="false" styleClass="primary-button" text="%item.stockcount.btn.post" />
                            </children>
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                        </HBox>

                        <!-- Scanning is the primary way in: the field keeps focus, and every
                             scan either adds a line or moves to the one already there. -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card">
                            <children>
                                <Label styleClass="form-label" text="%item.stockcount.label.scan.hint" />
                                <TextField fx:id="textScan" minWidth="320.0" promptText="%item.stockcount.prompt.scan" />
                                <Button fx:id="btnRemoveLine" mnemonicParsing="false" styleClass="neutral-button" text="%item.stockcount.btn.remove.line" />
                                <Label fx:id="labelScanHint" styleClass="kpi-hint" text="" />
                            </children>
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                        </HBox>

                        <HBox fx:id="kpiStrip" alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox styleClass="kpi-tile" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="kpi-title" text="%item.stockcount.kpi.line.count" />
                                        <Text fx:id="textLineCount" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="kpi-value" text="0" />
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <styleClass>
                                        <String fx:value="kpi-tile" />
                                        <String fx:value="kpi-low" />
                                    </styleClass>
                                    <children>
                                        <Label styleClass="kpi-title" text="%item.stockcount.kpi.diff.count" />
                                        <Text fx:id="textDiffCount" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="kpi-value" text="0" />
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <styleClass>
                                        <String fx:value="kpi-tile" />
                                        <String fx:value="kpi-sale" />
                                    </styleClass>
                                    <children>
                                        <Label styleClass="kpi-title" text="%item.stockcount.kpi.surplus" />
                                        <Text fx:id="textSurplus" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="kpi-value" text="0.000" />
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <styleClass>
                                        <String fx:value="kpi-tile" />
                                        <String fx:value="kpi-cost" />
                                    </styleClass>
                                    <children>
                                        <Label styleClass="kpi-title" text="%item.stockcount.kpi.shortage" />
                                        <Text fx:id="textShortage" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="kpi-value" text="0.000" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="6.0" />
                    </padding>
                </VBox>
            </top>
            <center>
                <VBox BorderPane.alignment="CENTER">
                    <children>
                        <TableView fx:id="tableView" styleClass="modern-table" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets bottom="6.0" left="6.0" right="6.0" />
                    </padding>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
