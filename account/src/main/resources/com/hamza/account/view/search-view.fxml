<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="stackPane" minHeight="560.0" minWidth="800.0"
           styleClass="app-root,item-picker"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.others.SearchItemsController">
    <children>
        <BorderPane styleClass="app-container">
            <top>
                <VBox spacing="10.0" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-card,item-picker-header">
                            <children>
                                <Label fx:id="headerIcon" styleClass="page-header-icon" />
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="app-title" text="%search.items.title" />
                                        <Label styleClass="app-subtitle" text="%search.items.subtitle" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="labelCount" styleClass="item-picker-count" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card,item-picker-search">
                            <children>
                                <Label fx:id="searchIcon" styleClass="page-header-icon" />
                                <TextField fx:id="txtSearch" promptText="%search.items.search.prompt"
                                           HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <center>
                <VBox spacing="10.0" styleClass="app-card,item-picker-content"
                      BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="section-title" text="%search.items.section.results" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="labelResultsCount" styleClass="kpi-hint" />
                            </children>
                        </HBox>
                        <Pagination fx:id="pagination" minHeight="260.0" minWidth="-Infinity"
                                    VBox.vgrow="ALWAYS" />
                        <TitledPane fx:id="selectedPane" animated="false" expanded="false"
                                    styleClass="item-picker-selected-pane">
                            <content>
                                <TableView fx:id="tableSelected" minHeight="150.0" prefHeight="190.0" />
                            </content>
                        </TitledPane>
                    </children>
                    <BorderPane.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </BorderPane.margin>
                </VBox>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="app-toolbar,item-picker-footer"
                      BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="btnClearSelection" mnemonicParsing="false"
                                styleClass="app-neutral-button" text="%search.items.clear" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="keyboard-hint" text="%search.items.keyboard.hint" />
                        <Button fx:id="btnClose" mnemonicParsing="false"
                                styleClass="app-neutral-button" text="%cancel" />
                        <Button fx:id="btnSave" mnemonicParsing="false"
                                styleClass="app-primary-button" text="%search.items.confirm.empty" />
                    </children>
                    <padding>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </padding>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
