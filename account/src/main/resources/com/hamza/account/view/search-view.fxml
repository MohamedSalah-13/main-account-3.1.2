<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="stackPane" minHeight="-Infinity" minWidth="-Infinity" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.others.SearchItemsController">
    <children>
        <BorderPane styleClass="app-container">
            <top>
                <VBox spacing="10.0" BorderPane.alignment="CENTER">
                    <children>

                        <!-- Page header -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-card">
                            <children>
                                <FontIcon fx:id="headerIcon" styleClass="page-header-icon" />
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="labelTitle" styleClass="app-title" text="Search" />
                                        <Label fx:id="labelSubtitle" styleClass="app-subtitle" text="Search for an item" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="labelCount" styleClass="kpi-hint" />
                            </children>
                        </HBox>

                        <!-- Search bar -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card">
                            <children>
                                <FontIcon fx:id="searchIcon" styleClass="page-header-icon" />
                                <Label fx:id="labelSearch" styleClass="form-label" text="Search" />
                                <TextField fx:id="txtSearch" HBox.hgrow="ALWAYS" />
                                <CheckBox fx:id="checkAddDirect" mnemonicParsing="false" text="%search.items.checkbox.direct" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>
            <bottom>
                <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="app-toolbar" BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="btnSave" mnemonicParsing="false" styleClass="app-primary-button" text="Save" />
                        <Button fx:id="btnClose" mnemonicParsing="false" styleClass="app-danger-button" text="Close" />
                    </children>
                    <padding>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </padding>
                </HBox>
            </bottom>
            <center>
                <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="app-scroll-pane" BorderPane.alignment="CENTER">
                    <content>
                        <SplitPane fx:id="splitPane" dividerPositions="0.5" orientation="VERTICAL" styleClass="search-split-pane">
                            <items>

                                <!-- Search results -->
                                <VBox spacing="8.0" styleClass="app-card">
                                    <children>
                                        <Label text="%search.items.section.results" styleClass="section-title" />
                                        <Pagination fx:id="pagination" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="500.0" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>

                                <!-- Items staged onto the invoice -->
                                <VBox spacing="8.0" styleClass="app-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="%search.items.section.added" styleClass="section-title" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnAdd2" mnemonicParsing="false" styleClass="app-neutral-button" text="إضافة" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="tableView" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="500.0" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</StackPane>
