<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="540.0" minWidth="860.0" prefHeight="620.0" prefWidth="1040.0"
            styleClass="app-root,barcode-print-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hamza.account.view.barcode.PrintBarcode">
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets bottom="4.0" left="16.0" right="16.0" top="14.0"/>
            </padding>
            <VBox spacing="3.0">
                <Label fx:id="labelTitle" styleClass="title-label" text="%barcode.print.title"/>
                <Label styleClass="app-subtitle" text="%barcode.print.subtitle"/>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card">
                <Label styleClass="form-label" text="%barcode.print.printer"/>
                <ComboBox fx:id="comboPrinter" maxWidth="1.7976931348623157E308"
                          styleClass="modern-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefreshPrinters" mnemonicParsing="false"
                        styleClass="neutral-button" text="%refresh"/>
                <Label fx:id="labelPrinterStatus" maxWidth="340.0" styleClass="status-label" wrapText="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.67">
            <items>
                <VBox minWidth="500.0" spacing="8.0">
                    <padding>
                        <Insets bottom="4.0" left="16.0" right="6.0" top="4.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="app-card">
                        <Label styleClass="form-label" text="%barcode.print.quantity.all"/>
                        <TextField fx:id="txtQuantityAll" maxWidth="95.0" prefColumnCount="6"
                                   styleClass="modern-input"/>
                        <Button fx:id="btnApplyQuantity" mnemonicParsing="false"
                                styleClass="neutral-button" text="%barcode.print.quantity.apply"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="btnRemoveSelected" mnemonicParsing="false"
                                styleClass="danger-button" text="%barcode.print.remove.selected"/>
                    </HBox>
                    <TableView fx:id="tableView" editable="true" styleClass="app-table" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox minWidth="300.0" prefWidth="340.0" spacing="8.0">
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="16.0" top="4.0"/>
                    </padding>
                    <VBox minHeight="210.0" spacing="6.0" styleClass="app-card" VBox.vgrow="ALWAYS">
                        <Label styleClass="section-title" text="%barcode.print.preview.title"/>
                        <StackPane minHeight="150.0" styleClass="barcode-preview-surface" VBox.vgrow="ALWAYS">
                            <ImageView fx:id="previewImage" fitHeight="210.0" fitWidth="300.0"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>
                        <Label fx:id="labelPreviewStatus" maxWidth="1.7976931348623157E308"
                               styleClass="status-label" text="%barcode.print.preview.empty" wrapText="true"/>
                    </VBox>
                    <VBox spacing="7.0" styleClass="app-card,barcode-options-card">
                        <Label styleClass="section-title" text="%barcode.print.options.title"/>
                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                            <Label fx:id="labelSize" styleClass="status-label"/>
                            <Label fx:id="labelNamePolicy" styleClass="status-label"/>
                        </HBox>
                        <GridPane hgap="18.0" vgap="7.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>
                            <CheckBox fx:id="checkDoubleLabel" styleClass="modern-check-box"
                                      text="%settings.barcode.showDouble"/>
                            <CheckBox fx:id="checkShowName" styleClass="modern-check-box"
                                      text="%settings.barcode.showName" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="checkShowPrice" styleClass="modern-check-box"
                                      text="%settings.barcode.showPrice" GridPane.rowIndex="1"/>
                            <CheckBox fx:id="checkShowBarcode" styleClass="modern-check-box"
                                      text="%settings.barcode.showBarcodeNumber"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <VBox spacing="6.0">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="4.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-card">
                <Label fx:id="labelItemsCount" styleClass="barcode-summary-pill"/>
                <Label fx:id="labelLabelsCount" styleClass="barcode-summary-pill"/>
                <Label fx:id="labelOperationStatus" maxWidth="1.7976931348623157E308"
                       styleClass="status-label" HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="progress" maxHeight="24.0" maxWidth="24.0"
                                   minHeight="24.0" minWidth="24.0" visible="false" managed="false"/>
                <Button fx:id="btnPreview" mnemonicParsing="false"
                        styleClass="neutral-button" text="%barcode.print.preview.action"/>
                <Button fx:id="btnPrint" defaultButton="true" mnemonicParsing="false"
                        styleClass="primary-button" text="%barcode.print.action"/>
                <Button fx:id="btnClose" cancelButton="true" mnemonicParsing="false"
                        styleClass="neutral-button" text="%close"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
