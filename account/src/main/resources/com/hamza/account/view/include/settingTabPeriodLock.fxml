<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10.0" styleClass="settings-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
    <children>

        <VBox spacing="4.0" styleClass="app-card">
            <children>
                <Label styleClass="section-title" text="الفترة المحاسبية" />
                <Label fx:id="labelState" styleClass="kpi-value" text="الفترة مفتوحة" />
                <Label fx:id="labelDetail" styleClass="kpi-hint" text="" />
                <Label styleClass="info-text" text="إغلاق فترة يعني أن كل ما قبل التاريخ المحدد قد تمت مراجعته وإصدار تقاريره، ولا يُعدَّل ولا يُحذف بعد ذلك. التصحيح داخل فترة مغلقة يحتاج صلاحية خاصة." wrapText="true" />
            </children>
        </VBox>

        <VBox spacing="8.0" styleClass="app-card">
            <children>
                <Label styleClass="section-title" text="إغلاق حتى تاريخ" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label minWidth="80.0" styleClass="form-label" text="التاريخ" />
                        <DatePicker fx:id="datePicker" minWidth="160.0" />
                        <Label styleClass="form-label" text="السبب" />
                        <TextField fx:id="textNotes" minWidth="240.0" promptText="اختياري - مثال: إقفال سنة 2025" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnReopen" mnemonicParsing="false" styleClass="danger-button" text="فتح الفترة" />
                        <Button fx:id="btnClose" mnemonicParsing="false" styleClass="primary-button" text="إغلاق الفترة" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="6.0" styleClass="app-card" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="section-title" text="سجل الإغلاق" />
                <TableView fx:id="tableHistory" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLockedUntil" prefWidth="140.0" text="مغلق حتى" />
                        <TableColumn fx:id="colClosedAt" prefWidth="170.0" text="وقت التسجيل" />
                        <TableColumn fx:id="colNotes" prefWidth="300.0" text="السبب" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
