<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="app-root,item-card-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.items.CardController">
    <children>
        <BorderPane styleClass="item-card-shell">
            <top>
                <VBox spacing="12.0" BorderPane.alignment="CENTER">
                    <children>
                        <FlowPane alignment="CENTER_LEFT" hgap="16.0" prefWrapLength="900.0" vgap="12.0"
                                  styleClass="item-card-hero">
                            <children>
                                <HBox alignment="CENTER_LEFT" minWidth="370.0" spacing="12.0">
                                    <children>
                                        <StackPane fx:id="headerIconHost" styleClass="item-card-hero-icon" />
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="item-card-title" text="%item.card.title" />
                                                <Label maxWidth="620.0" styleClass="item-card-subtitle"
                                                       text="%item.card.subtitle" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <VBox minWidth="260.0" spacing="5.0" styleClass="item-card-identity">
                                    <children>
                                        <Label fx:id="labelItemName" styleClass="item-card-item-name" />
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label styleClass="item-card-meta-caption" text="%item.card.base.unit" />
                                                <Label fx:id="labelBaseUnit" styleClass="item-card-meta-value" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>

                        <VBox spacing="10.0" styleClass="app-card,item-card-filter-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="app-section-title" text="%item.card.filter.title" />
                                        <Button fx:id="btnToday" mnemonicParsing="false" styleClass="filter-chip"
                                                text="%item.card.period.today" />
                                        <Button fx:id="btnThisMonth" mnemonicParsing="false" styleClass="filter-chip"
                                                text="%item.card.period.month" />
                                        <Button fx:id="btnAllHistory" mnemonicParsing="false" styleClass="filter-chip"
                                                text="%item.card.period.all" />
                                    </children>
                                </HBox>
                                <FlowPane alignment="CENTER_LEFT" hgap="12.0" prefWrapLength="930.0" vgap="10.0">
                                    <children>
                                        <VBox minWidth="165.0" prefWidth="190.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-label" text="%from" />
                                                <DatePicker fx:id="dateFrom" editable="false"
                                                            maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                        <VBox minWidth="165.0" prefWidth="190.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-label" text="%to" />
                                                <DatePicker fx:id="dateTo" editable="false"
                                                            maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                        <VBox minWidth="180.0" prefWidth="215.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-label" text="%invoice.stock" />
                                                <ComboBox fx:id="comboStock" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                        <VBox minWidth="180.0" prefWidth="215.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-label" text="%item.card.invoice.type" />
                                                <ComboBox fx:id="comboBox" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                        <HBox alignment="BOTTOM_LEFT" spacing="8.0">
                                            <children>
                                                <Button fx:id="btnSearch" mnemonicParsing="false"
                                                        styleClass="primary-button" text="%search" />
                                                <Button fx:id="btnPrint" mnemonicParsing="false"
                                                        styleClass="neutral-button" text="%print" />
                                            </children>
                                        </HBox>
                                    </children>
                                </FlowPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </top>

            <center>
                <VBox spacing="8.0" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="item-card-table-heading">
                            <children>
                                <Label fx:id="labelStatus" styleClass="item-card-status"
                                       text="%item.card.status.loading" />
                                <Label styleClass="item-card-table-hint" text="%item.card.table.hint" />
                            </children>
                        </HBox>
                        <StackPane fx:id="tableHost" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tableView" styleClass="app-table,item-card-table" />
                                <StackPane fx:id="loadingPane" managed="false" styleClass="item-card-loading"
                                           visible="false">
                                    <children>
                                        <VBox alignment="CENTER" spacing="8.0">
                                            <children>
                                                <ProgressIndicator fx:id="progress" maxHeight="34.0" maxWidth="34.0"
                                                                   visible="false" />
                                                <Label styleClass="item-card-loading-text"
                                                       text="%item.card.status.loading" />
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </center>

            <bottom>
                <VBox spacing="8.0" styleClass="item-card-summary" BorderPane.alignment="CENTER">
                    <children>
                        <FlowPane alignment="CENTER_LEFT" hgap="10.0" prefWrapLength="930.0" vgap="8.0">
                            <children>
                                <VBox minWidth="150.0" spacing="3.0"
                                      styleClass="item-card-metric-card,item-card-metric-opening">
                                    <children>
                                        <Label styleClass="item-card-metric-caption"
                                               text="%item.card.opening.balance" />
                                        <Label fx:id="textOpeningBalance" styleClass="item-card-metric-value" text="0" />
                                    </children>
                                </VBox>
                                <VBox minWidth="150.0" spacing="3.0"
                                      styleClass="item-card-metric-card,item-card-metric-net">
                                    <children>
                                        <Label styleClass="item-card-metric-caption"
                                               text="%item.card.net.movement" />
                                        <Label fx:id="textCountTotals" styleClass="item-card-metric-value" text="0" />
                                    </children>
                                </VBox>
                                <VBox minWidth="150.0" spacing="3.0"
                                      styleClass="item-card-metric-card,item-card-metric-closing">
                                    <children>
                                        <Label styleClass="item-card-metric-caption"
                                               text="%item.card.closing.balance" />
                                        <Label fx:id="textClosingBalance" styleClass="item-card-metric-value" text="0" />
                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>

                        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="item-card-summary-tabs">
                            <tabs>
                                <Tab text="%item.card.summary.quantities">
                                    <content>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8.0" prefWrapLength="930.0" vgap="8.0">
                                            <children>
                                                <VBox minWidth="135.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption" text="%pur" />
                                                        <Label fx:id="textPurchase" styleClass="item-card-detail-value" text="0" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="135.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption" text="%sales" />
                                                        <Label fx:id="textSales" styleClass="item-card-detail-value" text="0" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="155.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption" text="%RePur" />
                                                        <Label fx:id="textRePurchase" styleClass="item-card-detail-value" text="0" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="155.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption" text="%ReSal" />
                                                        <Label fx:id="textReSales" styleClass="item-card-detail-value" text="0" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </FlowPane>
                                    </content>
                                </Tab>
                                <Tab text="%item.card.summary.values">
                                    <content>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8.0" prefWrapLength="930.0" vgap="8.0">
                                            <children>
                                                <VBox minWidth="150.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption"
                                                               text="%item.card.total.purchase.cost" />
                                                        <Label fx:id="textCostPurchase" styleClass="item-card-detail-value" text="0.00" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="150.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption"
                                                               text="%item.card.total.sales.cost" />
                                                        <Label fx:id="textCostSales" styleClass="item-card-detail-value" text="0.00" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="175.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption"
                                                               text="%item.card.total.purchase.return" />
                                                        <Label fx:id="textCostPurchaseRe" styleClass="item-card-detail-value" text="0.00" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="175.0" spacing="2.0" styleClass="item-card-detail-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption"
                                                               text="%item.card.total.sales.return" />
                                                        <Label fx:id="textCostSalesRe" styleClass="item-card-detail-value" text="0.00" />
                                                    </children>
                                                </VBox>
                                                <VBox minWidth="145.0" spacing="2.0"
                                                      styleClass="item-card-detail-card,item-card-profit-card">
                                                    <children>
                                                        <Label styleClass="item-card-detail-caption"
                                                               text="%item.card.profit" />
                                                        <Label fx:id="textCostTotals" styleClass="item-card-detail-value" text="0.00" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </FlowPane>
                                    </content>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
