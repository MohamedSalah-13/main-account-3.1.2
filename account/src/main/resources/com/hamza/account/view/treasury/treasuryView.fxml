<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="root"
            fx:controller="com.hamza.account.controller.convert_treasury.TreasuryController"
            styleClass="app-root">

    <top>
        <VBox spacing="18" styleClass="page-container">
            <padding>
                <Insets top="24" right="28" bottom="18" left="28"/>
            </padding>

            <VBox spacing="6">
                <Label text="%treasury.screen.title" styleClass="page-title"/>
                <Label text="%treasury.screen.subtitle" styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="16" styleClass="app-card">
                <GridPane hgap="18" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints minWidth="320" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%treasury.field.name" styleClass="form-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                    <TextField fx:id="nameField"
                               promptText="%treasury.field.name.prompt"
                               styleClass="modern-input"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%treasury.field.opening" styleClass="form-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                    <TextField fx:id="amountField"
                               promptText="%treasury.field.opening.prompt"
                               styleClass="modern-input"
                               GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="%treasury.field.type" styleClass="form-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                    <ComboBox fx:id="typeCombo"
                              maxWidth="Infinity"
                              styleClass="modern-input"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="%treasury.field.state" styleClass="form-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                    <CheckBox fx:id="activeCheck"
                              text="%treasury.field.active"
                              selected="true"
                              GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                </GridPane>

                <Label fx:id="openingHint"
                       text="%treasury.hint.opening"
                       wrapText="true"
                       styleClass="page-subtitle"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="%common.new"
                            onAction="#newTreasury"
                            styleClass="secondary-button"/>

                    <Button text="%common.save"
                            onAction="#saveTreasury"
                            styleClass="primary-button"/>

                    <Button text="%common.edit"
                            onAction="#updateTreasury"
                            styleClass="warning-button"/>

                    <Button text="%common.refresh"
                            onAction="#loadTreasuries"
                            styleClass="neutral-button"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="table-section">
            <padding>
                <Insets top="8" right="28" bottom="28" left="28"/>
            </padding>

            <HBox alignment="CENTER_RIGHT">
                <Label text="%treasury.section.list" styleClass="section-title"/>
            </HBox>

            <!-- Columns are built in the controller with Columns.*, not declared here with
                 a field-name string: see rule ق-ل1 in docs/new-code-rules.md. -->
            <TableView fx:id="treasuryTable"
                       styleClass="app-table"
                       VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

</BorderPane>
