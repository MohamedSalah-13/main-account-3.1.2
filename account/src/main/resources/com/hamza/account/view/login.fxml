<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            minHeight="480.0" minWidth="350.0" prefHeight="500.0" prefWidth="380.0">
    <children>
        <VBox alignment="TOP_CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="TOP_CENTER" spacing="6.0">
                    <children>
                        <ImageView fx:id="imageView" fitHeight="80.0" fitWidth="120.0" pickOnBounds="true"
                                   preserveRatio="true" accessibleText="%login.logo.accessible"/>
                        <Text fx:id="textLoginName" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="login-title"
                              text="%common.login.screen"/>
                    </children>
                </VBox>

                <VBox maxWidth="310.0" spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label labelFor="$txtUsername" text="%user.username"/>
                        <HBox alignment="CENTER_LEFT" minHeight="38.0" styleClass="login-field-box">
                            <children>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@../image/person.png"/></image>
                                </ImageView>
                                <TextField fx:id="txtUsername" promptText="%user.username" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>

                        <Label labelFor="$pass" text="%user.password">
                            <VBox.margin><Insets top="6.0"/></VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" minHeight="38.0" styleClass="login-field-box">
                            <children>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@../image/password.png"/></image>
                                </ImageView>
                                <PasswordField fx:id="pass" promptText="%user.password" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>

                        <CheckBox fx:id="checkShowPass" mnemonicParsing="false" text="%user.show.password"/>

                        <HBox alignment="CENTER" minHeight="28.0" spacing="8.0">
                            <children>
                                <ProgressIndicator fx:id="loginProgress" maxHeight="22.0" maxWidth="22.0"
                                                   prefHeight="22.0" prefWidth="22.0" visible="false"/>
                                <Label fx:id="loginStatus" alignment="CENTER" maxWidth="260.0" styleClass="login-status"
                                       textAlignment="CENTER" wrapText="true"/>
                            </children>
                        </HBox>

                        <Button fx:id="btnEnter" defaultButton="true" maxWidth="1.7976931348623157E308"
                                minHeight="36.0" mnemonicParsing="false" text="%login.sign.in"/>
                        <Button fx:id="btnClose" cancelButton="true" maxWidth="1.7976931348623157E308"
                                minHeight="36.0" mnemonicParsing="false" text="%common.close"/>
                    </children>
                </VBox>

                <Text fx:id="textCopyRight" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="login-footer"
                      text="%common.login.copy.right"/>
            </children>
            <padding><Insets bottom="22.0" left="24.0" right="24.0" top="18.0"/></padding>
        </VBox>
    </children>
    <stylesheets><URL value="@../css/loginStyle.css"/></stylesheets>
</AnchorPane>
