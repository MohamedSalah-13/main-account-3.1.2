<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The shell of the expenses list. Everything in it is built by ExpensesController in code.

  An AnchorPane between the root and the content, because the row's details open over the list
  in a RowDetailDrawer, and an overlay needs a pane that lays a child out against its own edges
  without disturbing the siblings anchored across all four of them.
-->
<StackPane fx:id="stackPane" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamza.account.controller.expense.ExpensesController">
    <children>
        <AnchorPane fx:id="root">
            <children>
                <VBox fx:id="box" spacing="8.0" styleClass="app-container" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                    </padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>