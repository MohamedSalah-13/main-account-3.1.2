<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Two nodes, the way account-totals.fxml is: the form itself is built in
  AddNameController.

  What this file used to be is the argument. Every caption was an English placeholder
  ("Code", "Name", "area") that the controller replaced at runtime from a resource key -
  so a label the controller forgot shipped reading English, which is exactly how three
  CheckMenuItems on the statement screen came to read "Unspecified Action". The rows were
  numbered in one file and referred to in another, and V56's six new fields would have
  meant renumbering nine rows here and matching them there. Two files that have to agree
  about one screen did not have to agree about anything.
-->
<AnchorPane fx:id="screenRoot" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.name_account.AddNameController">
    <children>
        <VBox fx:id="formRoot" spacing="12.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />
    </children>
</AnchorPane>
