<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.setting.SettingController"
      xmlns="http://javafx.com/javafx/21"
      fx:id="box"
      spacing="0.0"
      styleClass="settings-main-root">
    <children>
        <VBox styleClass="settings-main-card" VBox.vgrow="ALWAYS">
            <children>
                <TabPane fx:id="pane"
                         tabClosingPolicy="UNAVAILABLE"
                         styleClass="settings-tab-pane"
                         VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="%settings.company.tabTitle"/>
                        <Tab text="%others"/>
                        <Tab text="%items"/>
                        <Tab text="%show"/>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</VBox>