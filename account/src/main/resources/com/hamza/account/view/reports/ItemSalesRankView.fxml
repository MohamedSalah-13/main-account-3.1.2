<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamza.account.controller.reports.ItemSalesRankController">
    <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-card" BorderPane.alignment="CENTER">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="report-title" text="%report.item.sales.rank.title" />
                                <Label styleClass="report-subtitle" text="%report.item.sales.rank.subtitle" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label styleClass="form-label" text="%report.item.sales.rank.year.colon" />
                        <ComboBox fx:id="comboYear" prefWidth="100.0" />

                        <Label styleClass="form-label" text="%report.item.sales.rank.month.colon" />
                        <ComboBox fx:id="comboMonth" prefWidth="120.0" />

                        <Button mnemonicParsing="false" onAction="#searchAction" styleClass="primary-button" text="%report.search.and.show" />

                        <Button onAction="#onExportPdf" styleClass="pdf-button" text="PDF" />
                        <Button onAction="#onExportExcel" styleClass="excel-button" text="Excel" />
                    </children>
                </HBox>
         </top>
         <center>
              <VBox spacing="16.0" styleClass="app-container">
                  <children>
      
                                  <SplitPane dividerPositions="0.6" minHeight="-Infinity" minWidth="-Infinity" styleClass="modern-split-pane" VBox.vgrow="ALWAYS">
                          <items>
                              <VBox spacing="10.0" styleClass="chart-card">
                                  <children>
                                      <Label styleClass="section-title" text="%report.item.sales.rank.details.hint" />
                                      <TableView fx:id="tableView" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="300.0" styleClass="app-table" VBox.vgrow="ALWAYS">
                                          <columns>
                                              <TableColumn fx:id="colItemName" prefWidth="250.0" text="%invoice.item.name" />
                                              <TableColumn fx:id="colTotalQty" prefWidth="120.0" text="%report.column.quantity.sold" />
                                              <TableColumn fx:id="colTotalAmount" prefWidth="150.0" text="%report.summary.total.sales" />
                                              <TableColumn fx:id="colTotalProfit" prefWidth="150.0" text="%report.item.sales.rank.net.profit" />
                                          </columns>
                                          <columnResizePolicy>
                                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                          </columnResizePolicy>
                                      </TableView>
                                  </children>
                              </VBox>
      
                                          <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="chart-card">
                                  <children>
                                      <Label styleClass="section-title" text="%report.item.sales.rank.top10.hint" />
                                      <PieChart fx:id="pieChartBestSellers" title="%report.item.sales.rank.top10.chart.title" VBox.vgrow="ALWAYS" />
                                  </children>
                              </VBox>
                          </items>
                      </SplitPane>
                  </children>
              </VBox>
         </center>
      </BorderPane>
    </children>
</AnchorPane>
