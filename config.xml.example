<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Template for config.xml, the database settings the application reads on startup.

  config.xml is not tracked in git because it holds the credentials of whichever
  database a given machine talks to. Copy this file to config.xml and fill it in.

  ConnectionToDatabase resolves the plain name "config.xml" against the JVM
  working directory, so the file belongs next to whatever you launch: the repo
  root when running from the root, account/ when running that module directly.

  Every value below is AES-encrypted and Base64-encoded, not plain text - the
  loader decrypts each element before use, so plain values fail at startup.
  Generate a real file with the CLI, which prints which key it used:

    java -cp controlsfx/target/classes \
      com.hamza.controlsfx.util.crypto.CryptoDatabaseConfig \
      encrypt <port> <host> <dbname> <username> <password> config.xml

  The CLI and the application now resolve the same key through
  CryptoDatabaseConfig.resolveConfigKey: the ACCOUNT_CONFIG_KEY environment
  variable if set, otherwise a config.key file next to config.xml, otherwise the
  built-in default. Both are read in the JVM working directory, so run the CLI
  from wherever the application launches and the file it writes will load.
  Installs that predate config.key keep working on the built-in default.

  secret_key.txt records the key each run encrypted with, for diagnosing a
  config.xml that stopped loading. It is never read back automatically - to
  switch keys, put the value in ACCOUNT_CONFIG_KEY or config.key and re-encrypt.

  url is "jdbc:mysql://<host>:<port>/<dbname>" and driver is
  "com.mysql.cj.jdbc.Driver" before encryption.
-->
<DatabaseConfig>
    <url>ENCRYPTED_JDBC_URL</url>
    <dbname>ENCRYPTED_DATABASE_NAME</dbname>
    <host>ENCRYPTED_HOST</host>
    <username>ENCRYPTED_USERNAME</username>
    <password>ENCRYPTED_PASSWORD</password>
    <port>ENCRYPTED_PORT</port>
    <driver>ENCRYPTED_DRIVER_CLASS</driver>
</DatabaseConfig>
